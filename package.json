{
  "name": "localdrop-lan",
  "version": "1.0.0",
  "description": "Production-ready, self-hosted LAN File Sharing Web Application using WebRTC and WebSockets",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "npx pkg . --targets node18-win-x64 --output LocalDrop-LAN.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  },
  "dependencies": {
    "archiver": "^5.3.1",
    "bonjour-service": "^1.4.4",
    "express": "^4.19.2",
    "puppeteer-core": "^25.14.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  }
}
